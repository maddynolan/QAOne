  "script": "from playwright.sync_api import expect\n\ndef test_s_form_submission_flow(page):\n    \"\"\"\n    S - Form Submission Flow\n    Recorded on: 2025-12-10T21:42:31.851620\n    Starting URL: chrome-extension://fkgbinijhehifiogjeaiiekabbognjoa/src/sidepanel/sidepanel.html\n    \"\"\"\n    page.goto(\"chrome-extension://fkgbinijhehifiogjeaiiekabbognjoa/src/sidepanel/sidepanel.html\")\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Click \"Get involved\"\n    page.get_by_role(\"button\", name=\"Get involved\").wait_for(state=\"visible\", timeout=10000)\n    page.get_by_role(\"button\", name=\"Get involved\").click()\n\n    # Click \"Join the donor registry\"\n    page.get_by_role(\"link\", name=\"Join the donor registry\").wait_for(state=\"visible\", timeout=15000)\n    page.get_by_role(\"link\", name=\"Join the donor registry\").click(force=True)\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Fallback selector used; could not determine robust selector for: Navigate to /s/join\n    # Navigate to /s/join\n    page.goto(\"https://my.nmdp.org/s/join?language=en_US\")\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Fallback selector used; could not determine robust selector for: Navigate to /s/join\n    # Navigate to /s/join\n    page.goto(\"https://my.nmdp.org/s/join?language=en_US\")\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Check input\n    page.locator(\"lightning-radio-group\").get_by_text(\"18-35\").check()\n\n    # Click \"Next\"\n    page.get_by_role(\"button\", name=\"Next\").wait_for(state=\"visible\", timeout=15000)\n    page.get_by_role(\"button\", name=\"Next\").click(force=True)\n\n    # Check input\n    page.locator('[name=\"Blood_Cancer_or_Disorder__c\"]').check()\n\n    # Check input\n    page.locator('[name=\"Brain_Injury_Concussion_or_Surgery__c\"]').check()\n\n    # Check input\n    page.locator('[name=\"Cancer__c\"]').check()\n\n    # Click \"Next\"\n    page.get_by_role(\"button\", name=\"Next\").wait_for(state=\"visible\", timeout=15000)\n    page.get_by_role(\"button\", name=\"Next\").click(force=True)\n\n    # Check input\n    page.get_by_text(\"Yes\", exact=True).check()\n\n    # Click \"Next\"\n    page.get_by_role(\"button\", name=\"Next\").wait_for(state=\"visible\", timeout=15000)\n    page.get_by_role(\"button\", name=\"Next\").click(force=True)\n\n    # Fallback selector used; could not determine robust selector for: Navigate to /s/create-account-medical\n    # Navigate to /s/create-account-medical\n    page.goto(\"https://my.nmdp.org/s/create-account-medical?language=en_US\")\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Fallback selector used; could not determine robust selector for: Navigate to /s/create-account-medical\n    # Navigate to /s/create-account-medical\n    page.goto(\"https://my.nmdp.org/s/create-account-medical?language=en_US\")\n    page.wait_for_load_state(\"domcontentloaded\")\n\n    # Click input\n    page.locator('[name=\"firstName\"]').wait_for(state=\"visible\", timeout=15000)\n    page.locator('[name=\"firstName\"]').click()\n\n    # Fill input\n    page.locator('[name=\"firstName\"]').wait_for(state=\"visible\", timeout=10000)\n    page.locator('[name=\"firstName\"]').fill(\"test\")\n\n    # Fill input\n    page.locator('[name=\"firstName\"]').wait_for(state=\"visible\", timeout=10000)\n    page.locator('[name=\"firstName\"]').fill(\"test\")\n\n    # Click input\n    page.locator('[name=\"lastName\"]').wait_for(state=\"visible\", timeout=15000)\n    page.locator('[name=\"lastName\"]').click()\n\n    # Fill input\n    page.locator('[name=\"lastName\"]').wait_for(state=\"visible\", timeout=10000)\n    page.locator('[name=\"lastName\"]').fill(\"test\")\n\n    # Fill input\n    page.locator('[name=\"lastName\"]').wait_for(state=\"visible\", timeout=10000)\n    page.locator('[name=\"lastName\"]').fill(\"test\")\n\n",
