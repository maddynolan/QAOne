{
  "name": "flowstral-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise application test recorder with auto-healing locators for 25+ applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flowstral": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:engine": "tsc",
    "watch": "tsc --watch",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "electron:dev": "vite build && electron electron/main.js",
    "electron:build": "vite build && electron-builder --config electron-builder.config.js",
    "electron:build:win": "vite build && electron-builder --config electron-builder.config.js --win",
    "electron:build:mac": "vite build && electron-builder --config electron-builder.config.js --mac",
    "electron:build:linux": "vite build && electron-builder --config electron-builder.config.js --linux"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "recorder",
    "salesforce",
    "workday",
    "servicenow",
    "sap",
    "pega",
    "enterprise",
    "auto-healing",
    "locators",
    "shadow-dom"
  ],
  "author": "Flowstral",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.86.2",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.13.13",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^11.1.0",
    "lucide-react": "^0.556.0",
    "monaco-editor": "^0.55.1",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^9.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.8"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flowstral/flowstral-engine"
  }
}
