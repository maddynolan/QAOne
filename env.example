# Environment Configuration for QA AI Platform
# Copy this file to .env and update with your actual values

# Custom LLM Configuration
VITE_LLM_ENDPOINT=http://localhost:8001/api/v1/generate
VITE_LLM_API_KEY=your-custom-llm-api-key
VITE_LLM_MODEL=qa-ai-model
VITE_LLM_TEMPERATURE=0.7
VITE_LLM_MAX_TOKENS=2000

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Configuration (if using Supabase for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Configuration (for FastAPI backend)
DATABASE_URL=postgresql://user:password@localhost:5432/qa_ai_platform
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_ai_platform

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Custom LLM Backend Configuration
LLM_ENDPOINT=http://localhost:8001/api/v1/generate
LLM_API_KEY=your-custom-llm-api-key
LLM_MODEL=qa-ai-model
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# Test Execution Configuration
POSTMAN_COLLECTION_PATH=/path/to/collections
PLAYWRIGHT_CONFIG_PATH=/path/to/playwright.config.js

# Logging Configuration
LOG_LEVEL=INFO

# vLLM Configuration (High-Performance Parallel Inference)
# Enable vLLM backend for GPU saturation and parallel processing
USE_VLLM=false
VLLM_URL=http://localhost:8000
VLLM_TIMEOUT=120
VLLM_MAX_CONCURRENT=256

# FP8 Quantization (for faster inference on Nvidia GPUs)
USE_FP8_QUANTIZATION=true

# vLLM Model Paths (HuggingFace format, not Ollama format)
VLLM_MODEL_QUICK=Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL_UI=Qwen/Qwen2.5-Coder-14B-Instruct
VLLM_MODEL_HEAVY=Qwen/Qwen2.5-Coder-32B-Instruct

# Ollama Configuration (Fallback/Default)
OLLAMA_URL=http://localhost:11434
USE_FINETUNED_MODEL=true
FINETUNED_MODEL_NAME=qa-expert:7b

# Enterprise Features Configuration
# Secrets Management
SECRETS_ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production

# Remote Browser Grid Configuration
GRID_PROVIDER=local  # Options: local, selenium_grid, moon, browserstack, saucelabs
SELENIUM_GRID_HUB_URL=http://localhost:4444
MOON_HUB_URL=http://localhost:4444
BROWSERSTACK_USERNAME=your-browserstack-username
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key
SAUCELABS_USERNAME=your-saucelabs-username
SAUCELABS_ACCESS_KEY=your-saucelabs-access-key

# JWT Configuration (for RBAC)
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-chars-change-in-production

# Air-Gapped Mode
AIR_GAPPED_MODE=false  # Set to true to block external LLM calls


