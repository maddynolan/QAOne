# Environment Configuration for QA AI Platform
# Copy this file to .env and update with your actual values

# Custom LLM Configuration
VITE_LLM_ENDPOINT=http://localhost:8001/api/v1/generate
VITE_LLM_API_KEY=your-custom-llm-api-key
VITE_LLM_MODEL=qa-ai-model
VITE_LLM_TEMPERATURE=0.7
VITE_LLM_MAX_TOKENS=2000

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Configuration (if using Supabase for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Configuration (for FastAPI backend)
DATABASE_URL=postgresql://user:password@localhost:5432/qa_ai_platform
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_ai_platform

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Custom LLM Backend Configuration
LLM_ENDPOINT=http://localhost:8001/api/v1/generate
LLM_API_KEY=your-custom-llm-api-key
LLM_MODEL=qa-ai-model
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# Test Execution Configuration
POSTMAN_COLLECTION_PATH=/path/to/collections
PLAYWRIGHT_CONFIG_PATH=/path/to/playwright.config.js

# Logging Configuration
LOG_LEVEL=INFO


