# Database Configuration
DATABASE_URL=postgresql://qa_user:qa_password@localhost:5432/qa_ai_platform
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_ai_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
PROJECT_NAME=QA AI Platform
VERSION=1.0.0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# Test Execution Configuration
POSTMAN_COLLECTION_PATH=/app/collections
PLAYWRIGHT_CONFIG_PATH=/app/playwright.config.js
TEST_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TESTS=5

# Cache Configuration
REDIS_CACHE_TTL_SECONDS=3600
REDIS_LLM_CACHE_TTL_SECONDS=86400
REDIS_TEST_RESULT_CACHE_TTL_SECONDS=7200

# Monitoring Configuration
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=QA AI Platform
NEXT_PUBLIC_VERSION=1.0.0

# Development Configuration
DEBUG=true
ENVIRONMENT=development
RELOAD=true

# Production Configuration (uncomment for production)
# DEBUG=false
# ENVIRONMENT=production
# RELOAD=false
# SECRET_KEY=your-production-secret-key
# DATABASE_URL=postgresql://user:password@db:5432/qa_ai_platform
# REDIS_URL=redis://redis:6379/0