# =============================================================================
# QAAI Environment Configuration
# Copy to .env and set values. Cloud-only (no OLLAMA) is the default for SaaS.
# =============================================================================

# -----------------------------------------------------------------------------
# Required for all deployments
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/qaai
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Cloud LLM (default for SaaS) – set at least one
# -----------------------------------------------------------------------------
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: which provider to prefer (openai, anthropic, local_qwen when OLLAMA enabled)
DEFAULT_LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# OLLAMA (optional – local LLM, not used for SaaS by default)
# -----------------------------------------------------------------------------
# Set ENABLE_OLLAMA_SERVICE=true and OLLAMA_URL only if using local Ollama.
# OLLAMA_URL=http://localhost:11434
# ENABLE_OLLAMA_SERVICE=false

# -----------------------------------------------------------------------------
# Frontend / Vite (build-time API URL)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Redis (optional, for queues/caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# S3 / object storage (optional, for artifacts)
# -----------------------------------------------------------------------------
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=qa-artifacts

# -----------------------------------------------------------------------------
# Database (alternative to DATABASE_URL)
# -----------------------------------------------------------------------------
POSTGRES_USER=qaai
POSTGRES_PASSWORD=your-password
POSTGRES_DB=qaai

# -----------------------------------------------------------------------------
# Multi-tenant / SaaS (optional)
# -----------------------------------------------------------------------------
# Tenants API is active. Clients can send X-Tenant-ID and X-User-ID headers
# or use JWT with tenant_id claim. See docs/DEPLOYMENT-AND-PACKAGING-REFERENCE.md
# section "SaaS compliance (multi-tenant/RBAC)".

# -----------------------------------------------------------------------------
# Air-gapped mode (blocks external LLM calls; use with OLLAMA)
# -----------------------------------------------------------------------------
AIR_GAPPED_MODE=false

# -----------------------------------------------------------------------------
# Other (legacy / optional)
# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# LOG_LEVEL=INFO
# SECRETS_ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production
