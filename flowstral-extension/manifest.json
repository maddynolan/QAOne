{
  "manifest_version": 3,
  "name": "Flowstral Recorder",
  "version": "1.1.0",
  "description": "Record browser interactions and generate automated test scripts with intelligent, self-healing selectors.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "optional_permissions": [
    "tabs",
    "webRequest",
    "downloads"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Flowstral Recorder"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/lib/*", "src/content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
