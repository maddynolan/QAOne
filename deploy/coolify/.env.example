# ===========================================
# Flowstral Backend — Coolify Environment
# ===========================================
# Copy this to your Coolify backend service environment variables.
# Replace ALL "CHANGE_ME" values before deploying to production.

# Database (use Coolify's internal service name)
DATABASE_URL=postgresql://qaai:CHANGE_ME@qaai-postgres:5432/qaai

# Redis (use Coolify's internal service name)
REDIS_URL=redis://qaai-redis:6379

# Object Storage (MinIO via Coolify)
S3_ENDPOINT_URL=http://qaai-minio:9000
# IMPORTANT: Replace with your actual MinIO credentials — do NOT use defaults
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET_NAME=qa-artifacts

# Security — REQUIRED: generate unique secrets for production
# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_256bit_secret
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key

# CORS — set to your actual frontend domain
CORS_ALLOWED_ORIGINS=https://your-domain.com

# AI / LLM
OPENAI_API_KEY=sk-proj-CHANGE_ME
DEFAULT_LLM_PROVIDER=openai
OPENAI_TEST_CASE_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000

# Frontend URL (for CORS)
FRONTEND_URL=https://app.flowstral.com

# Supabase Auth (if using Supabase for auth)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...

# Demo Data — DISABLED for production. Only enable for staging/demos.
SEED_DEMO_DATA=false

# LLM Usage Tracking
TRACK_LLM_USAGE=true

# Test Case LLM Provider (auto = use OPENAI_API_KEY)
TEST_CASE_LLM_PROVIDER=auto
