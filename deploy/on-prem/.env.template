# ============================================================
# Flowstral/QAAI — On-Premises Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# Lines marked [REQUIRED] must be set. Others have defaults.

# ==================== Database [REQUIRED] ====================
# Your PostgreSQL connection string
DATABASE_URL=postgresql://qaai_user:CHANGE_ME@your-db-host:5432/qaai?sslmode=require
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=qaai
DB_USER=qaai_user
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=require

# ==================== Security [REQUIRED] ====================
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# ==================== Application ====================
APP_ENV=production
LOG_LEVEL=INFO
AUDIT_MODE=strict
AUTO_MIGRATE=true
SEED_DEMO_DATA=false

# ==================== Domain & TLS [REQUIRED] ====================
# Your domain name (e.g., qaai.yourcompany.com)
DOMAIN=qaai.yourcompany.com
VITE_API_URL=https://qaai.yourcompany.com/api

# TLS certificate paths (relative to deploy/on-prem/)
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# ==================== Ports ====================
HTTPS_PORT=443
HTTP_PORT=80
BACKEND_PORT=8000

# ==================== CORS ====================
CORS_ORIGINS=https://qaai.yourcompany.com
ALLOWED_HOSTS=qaai.yourcompany.com

# ==================== AI (Optional — BYOK) ====================
# Leave blank to disable AI features. Users can add their own keys via Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# ==================== SSO (Optional) ====================
# SAML Service Provider entity ID and ACS URL
SAML_SP_ENTITY_ID=https://qaai.yourcompany.com/api/auth/sso/saml
SAML_SP_ACS_URL=https://qaai.yourcompany.com/api/auth/sso/saml/acs

# ==================== Image Tag ====================
IMAGE_TAG=latest

# ==================== Admin Account ====================
# Created by install.sh during initial setup
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Platform Admin
ORG_NAME=Your Company
