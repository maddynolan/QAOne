      {
        "id": "step_14",
        "order": 14,
        "qword": "CreateRecord",
        "type": "sf_create_record",
        "action": "Create Case 1",
        "description": "Create support Case",
        "args": {
          "objectType": "Case",
          "data": {
            "Subject": "Flowstral Test Case - Technical Support",
            "Status": "New",
            "Priority": "Medium",
            "Origin": "Web",
            "AccountId": "{{account1Id}}",
            "ContactId": "{{contact1Id}}",
            "Description": "Test case for support workflow testing"
          },
          "storeAs": "{{case1Id}}"
        },
        "expectedResult": "Case created"
      },
      {
        "id": "step_15",
        "order": 15,
        "qword": "CreateRecord",
        "type": "sf_create_record",
        "action": "Create Case 2",
        "description": "Create high priority Case",
        "args": {
          "objectType": "Case",
          "data": {
            "Subject": "Flowstral Test Case - High Priority",
            "Status": "Working",
            "Priority": "High",
            "Origin": "Phone",
            "AccountId": "{{account2Id}}",
            "ContactId": "{{contact3Id}}",
            "Description": "Test case with high priority for escalation testing"
          },
          "storeAs": "{{case2Id}}"
        },
        "expectedResult": "Case created"
      },
      {
        "id": "step_16",
        "order": 16,
        "qword": "ExecuteSOQL",
        "type": "sf_soql",
        "action": "Verify All Data Created",
        "description": "Query to verify all test data was created",
        "args": {
          "query": "SELECT COUNT() FROM Account WHERE Name LIKE 'Flowstral Test%'",
          "storeAs": "{{accountCount}}"
        },
        "expectedResult": "Returns count of 3 accounts"
      },
      {
        "id": "step_17",
        "order": 17,
        "qword": "AssertSOQL",
        "type": "sf_assert_soql",
        "action": "Assert Accounts Created",
        "description": "Verify accounts were created",
        "args": {
          "query": "SELECT COUNT() FROM Account WHERE Name LIKE 'Flowstral Test%'",
          "assertion": "count == 3"
        },
        "expectedResult": "3 test accounts exist"
      },
      {
        "id": "step_18",
        "order": 18,
        "qword": "AssertSOQL",
        "type": "sf_assert_soql",
        "action": "Assert Contacts Created",
        "description": "Verify contacts were created",
        "args": {
          "query": "SELECT COUNT() FROM Contact WHERE Email LIKE '%flowstral%'",
          "assertion": "count == 4"
        },
        "expectedResult": "4 test contacts exist"
      },
      {
        "id": "step_19",
        "order": 19,
        "qword": "AssertSOQL",
        "type": "sf_assert_soql",
        "action": "Assert Opportunities Created",
        "description": "Verify opportunities were created",
        "args": {
          "query": "SELECT COUNT() FROM Opportunity WHERE Name LIKE 'Flowstral Test%'",
          "assertion": "count == 3"
        },
        "expectedResult": "3 test opportunities exist"
      },
      {
        "id": "step_20",
        "order": 20,
        "qword": "ExecuteSOQL",
        "type": "sf_soql",
        "action": "Query All Test Data Summary",
        "description": "Get summary of all created test data",
        "args": {
          "query": "SELECT Name, Industry, (SELECT Name, Email FROM Contacts), (SELECT Name, StageName FROM Opportunities) FROM Account WHERE Name LIKE 'Flowstral Test%'",
          "storeAs": "{{testDataSummary}}"
        },
        "expectedResult": "Returns all test data with relationships"
      }
    ],
