{
  "id": "tc_sf_data_loader",
  "name": "SF Tools - Data Loader (Run First)",
  "description": "Creates test data in your Salesforce org for testing all SF Tools features. Run this BEFORE testing SF Tools.",
  "priority": "high",
  "automationStatus": "automated",
  "tags": ["salesforce", "data-setup", "prerequisite"],
  "preconditions": [
    "User is logged into Salesforce org as System Administrator",
    "Org has available DML limits (this creates ~15 records)"
  ],
  "unified_data": {
    "steps": [
      {
        "id": "step_1",
        "order": 1,
        "qword": "goto",
        "type": "navigate",
        "action": "Navigate to Salesforce",
        "description": "Navigate to Salesforce Home",
        "args": ["https://YOUR_ORG.lightning.force.com"],
        "expectedResult": "Salesforce home page loads"
      },
      {
        "id": "step_2",
        "order": 2,
        "qword": "CreateRecord",
        "type": "sf_create_record",
        "action": "Create Parent Account 1",
        "description": "Create first test Account (Technology)",
        "args": {
          "objectType": "Account",
          "data": {
            "Name": "Flowstral Test Corp - Technology",
            "Industry": "Technology",
            "Type": "Customer - Direct",
            "BillingStreet": "123 Tech Park Drive",
            "BillingCity": "San Francisco",
            "BillingState": "CA",
            "BillingPostalCode": "94105",
            "BillingCountry": "USA",
            "Phone": "415-555-1001",
            "Website": "https://flowstral-tech.example.com",
            "Description": "Test account for SF Tools - Technology sector"
          },
          "storeAs": "{{account1Id}}"
        },
        "expectedResult": "Account created"
      },
      {
        "id": "step_3",
        "order": 3,
        "qword": "CreateRecord",
        "type": "sf_create_record",
