            "Probability": 100,
            "Type": "New Customer",
            "LeadSource": "Web",
            "Description": "Test opportunity that was won"
          },
          "storeAs": "{{opp3Id}}"
        },
        "expectedResult": "Opportunity created at Closed Won"
      },
      {
