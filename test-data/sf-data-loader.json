        "expectedResult": "Lead created"
      },
      {
        "id": "step_13",
        "order": 13,
        "qword": "CreateRecord",
        "type": "sf_create_record",
        "action": "Create Lead 2",
        "description": "Create qualified Lead",
        "args": {
          "objectType": "Lead",
          "data": {
            "FirstName": "Frank",
            "LastName": "Qualified",
            "Company": "Qualified Inc",
            "Title": "Director",
            "Email": "frank.qualified@qualifiedinc.example.com",
            "Phone": "555-555-4002",
