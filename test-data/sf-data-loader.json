      "contact3Id": { "type": "id", "description": "Carol Finance Contact ID" },
      "contact4Id": { "type": "id", "description": "David Health Contact ID" },
      "opp1Id": { "type": "id", "description": "Prospecting Opportunity ID" },
      "opp2Id": { "type": "id", "description": "Qualification Opportunity ID" },
      "opp3Id": { "type": "id", "description": "Closed Won Opportunity ID" },
      "lead1Id": { "type": "id", "description": "Open Lead ID" },
