{
  "name": "flowstral-desktop",
  "version": "3.25.0",
  "description": "Flowstral Desktop - Full On-Prem Test Automation Platform",
  "main": "src/main/index.js",
  "author": "Flowstral Inc.",
  "license": "Commercial",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:webapp": "cd .. && npx vite build --base ./ && rmdir /S /Q flowstral-desktop\\webapp 2>nul & xcopy /E /I /Y dist flowstral-desktop\\webapp",
    "build:webapp:unix": "cd .. && VITE_BASE=./ npm run build && cp -r dist ../flowstral-desktop/webapp",
    "prebuild": "npm run build:webapp",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^11.10.0",
    "crypto-js": "^4.2.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "node-machine-id": "^1.1.12",
    "playwright": "^1.40.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.flowstral.desktop",
    "productName": "Flowstral",
    "copyright": "Copyright © 2024 Flowstral Inc.",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "webapp/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright/.local-browsers",
        "to": "browsers",
        "filter": [
          "chromium*/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Flowstral Inc.",
      "signingHashAlgorithms": ["sha256"]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "portable": {
      "artifactName": "Flowstral-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Flowstral-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "maddynolan",
      "repo": "QAOne"
    }
  }
}
