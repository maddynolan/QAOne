{
  "dashboard": {
    "title": "QA AI Platform - System Metrics",
    "tags": ["qa-ai", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Test Runs Total",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(qaai_test_runs_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Test Run Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(qaai_test_runs_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(qaai_test_runs_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "AI Generations Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(qaai_ai_generations_total[5m])) by (provider)",
            "legendFormat": "{{provider}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "AI Generation Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(qaai_ai_generation_duration_seconds_bucket[5m])) by (le, provider))",
            "legendFormat": "{{provider}} - 95th"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "AI Tokens Used",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(qaai_ai_tokens_total[5m])) by (provider, type)",
            "legendFormat": "{{provider}} - {{type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "AI Cost (USD)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(qaai_ai_cost_usd_total[1h]))",
            "legendFormat": "Last Hour"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "API Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(qaai_api_requests_total[5m])) by (endpoint, status_code)",
            "legendFormat": "{{endpoint}} - {{status_code}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "API Request Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(qaai_api_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
      },
      {
        "id": 9,
        "title": "Defects by Severity",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(qaai_defects_total) by (severity)",
            "legendFormat": "{{severity}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}
      },
      {
        "id": 10,
        "title": "Active Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(qaai_active_sessions) by (session_type)",
            "legendFormat": "{{session_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}
      }
    ]
  }
}

